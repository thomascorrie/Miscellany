<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(MiscellanyTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Miscellany</RootNamespace>
    <AssemblyName>Miscellany</AssemblyName>
    <!-- The XML documentation provides the node descriptions and tooltips in Dynamo -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Copy NuGet dependencies (3DContainerPacking) to the output so they can be packaged -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <!-- Dynamo 3+ loads packages as plugins -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <!-- Dynamo assemblies are supplied by the host, so only compile against them (ExcludeAssets="runtime").
       Build against the oldest supported version of each generation so the package loads in every later version. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="DynamoVisualProgramming.DynamoServices" Version="2.1.0.7451" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="DynamoVisualProgramming.ZeroTouchLibrary" Version="2.1.0.7451" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="DynamoVisualProgramming.DynamoCoreNodes" Version="2.1.0.7451" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="DynamoVisualProgramming.DynamoServices" Version="3.0.4.7905" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="DynamoVisualProgramming.ZeroTouchLibrary" Version="3.0.4.7905" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="DynamoVisualProgramming.DynamoCoreNodes" Version="3.0.4.7905" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="3DContainerPacking" Version="1.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Node icons are built into Miscellany.customization.dll by the Miscellany.Customization project -->
    <None Remove="Resources\**" />
    <EmbeddedResource Remove="Resources\**" />
    <None Include="pkg.json" />
    <Content Include="Miscellany_DynamoCustomization.xml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Miscellany.Migrations.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
